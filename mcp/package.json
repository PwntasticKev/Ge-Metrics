{
  "name": "ge-metrics-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets AI agents analyze the OSRS Grand Exchange: live prices, flips after tax, set arbitrage, processing methods, dips and game update impact.",
  "type": "module",
  "bin": {
    "ge-metrics-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "backtest": "tsup && node dist/backtest.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "osrs",
    "old-school-runescape",
    "grand-exchange",
    "flipping"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PwntasticKev/Ge-Metrics.git",
    "directory": "mcp"
  }
}
